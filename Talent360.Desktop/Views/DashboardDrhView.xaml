<UserControl x:Class="Talent360.Desktop.Views.DashboardDrhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:Talent360.Desktop.ViewModels"
             Background="#F5F6FA">

    <UserControl.DataContext>
        <vm:DashboardDrhViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- TITRE -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Dashboard DRH" FontSize="28" FontWeight="Bold"
                           Foreground="#1B2A4A" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Afficher :" FontSize="13" Foreground="#4B5563" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="FilterSourceComboBox" Width="220" SelectedIndex="1" SelectionChanged="FilterSourceComboBox_SelectionChanged">
                        <ComboBoxItem Content="Tout"/>
                        <ComboBoxItem Content="Données réelles uniquement" IsSelected="True"/>
                        <ComboBoxItem Content="Démonstration uniquement"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- CARTES KPI - Ligne 1 -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,16">
                <Border Background="#2563EB" CornerRadius="12" Margin="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Population totale" Foreground="#B3D4FC" FontSize="13"/>
                        <TextBlock Text="{Binding PopulationTotale}" Foreground="White"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#059669" CornerRadius="12" Margin="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Talents validés" Foreground="#A7F3D0" FontSize="13"/>
                        <TextBlock Text="{Binding NombreTalentsValides}" Foreground="White"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#7C3AED" CornerRadius="12" Margin="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Hauts potentiels" Foreground="#DDD6FE" FontSize="13"/>
                        <TextBlock Text="{Binding NombreHautsPotentiels}" Foreground="White"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#D97706" CornerRadius="12" Margin="6" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Viviers actifs" Foreground="#FDE68A" FontSize="13"/>
                        <TextBlock Text="{Binding NombreViviersActifs}" Foreground="White"
                                   FontSize="36" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- CARTES KPI - Ligne 2 -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="12" Margin="6" Padding="20"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Postes critiques couverts" Foreground="#6B7280" FontSize="13"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PostesCritiquesCouverts}" FontSize="28"
                                       FontWeight="Bold" Foreground="#059669"/>
                            <TextBlock Text=" / " FontSize="28" Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding PostesCritiquesTotaux}" FontSize="28"
                                       FontWeight="Bold" Foreground="#1B2A4A"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="#9CA3AF">
                            <Run Text="Taux : "/><Run Text="{Binding TauxCouverture, Mode=OneWay}"/><Run Text=" %"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Margin="6" Padding="20"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sans relève" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Text="{Binding PostesCritiquesSansReleve}" FontSize="28"
                                   FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        <TextBlock Text="postes à risque" FontSize="12" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Margin="6" Padding="20"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Ready Now" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock Text="{Binding NombreReadyNow}" FontSize="28"
                                   FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                        <TextBlock Text="prêts immédiatement" FontSize="12" Foreground="#9CA3AF"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Margin="6" Padding="20"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Engagement moyen" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0">
                            <Run Text="{Binding EngagementMoyen, Mode=OneWay}"/><Run Text=" %"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- GRAPHIQUE + ALERTES côte à côte -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Graphique 9-Box répartition -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="6"
                        Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Répartition 9-Box" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1B2A4A" Margin="0,0,0,12"/>
                        <lvc:PieChart Series="{Binding NeufBoxSeries}" Height="280"
                                      LegendPosition="Right"/>
                    </StackPanel>
                </Border>

                <!-- Liste des alertes -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="6"
                        Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Alertes RH" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#1B2A4A" Margin="0,0,0,12"/>
                        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Alertes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10" CornerRadius="6"
                                                Background="{Binding Background}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NiveauIcon}" FontSize="16"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                           FontSize="12.5" VerticalAlignment="Center"
                                                           Foreground="#1F2937" MaxWidth="350"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
