<UserControl x:Class="Talent360.Desktop.Views.DashboardDgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Talent360.Desktop.ViewModels"
             Background="#F5F6FA">

    <UserControl.DataContext>
        <vm:DashboardDgViewModel/>
    </UserControl.DataContext>

    <Grid Margin="40" VerticalAlignment="Center">
        <StackPanel MaxWidth="900" HorizontalAlignment="Center">

            <!-- TITRE -->
            <TextBlock Text="Synthèse Direction Générale" FontSize="30" FontWeight="Bold"
                       Foreground="#1B2A4A" HorizontalAlignment="Center" Margin="0,0,0,32"/>
            <TextBlock Text="Indicateurs clés — Talent Review" FontSize="15"
                       Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!-- 4 CARTES PRINCIPALES -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,32">
                <!-- Taux de couverture -->
                <Border Background="White" CornerRadius="16" Margin="8" Padding="24"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Couverture postes critiques" Foreground="#6B7280"
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock FontSize="44" FontWeight="Bold" Foreground="#059669"
                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Run Text="{Binding TauxCouverture, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PostesCritiquesCouverts}" FontWeight="SemiBold"
                                       Foreground="#059669"/>
                            <TextBlock Text=" / " Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding PostesCritiquesTotaux}" FontWeight="SemiBold"
                                       Foreground="#1B2A4A"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Talents validés -->
                <Border Background="White" CornerRadius="16" Margin="8" Padding="24"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Talents validés" Foreground="#6B7280"
                                   FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="{Binding NombreTalentsValides}" FontSize="44"
                                   FontWeight="Bold" Foreground="#7C3AED"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="collaborateurs identifiés" FontSize="11"
                                   Foreground="#9CA3AF" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Postes sans relève -->
                <Border Background="White" CornerRadius="16" Margin="8" Padding="24"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Postes sans relève" Foreground="#6B7280"
                                   FontSize="12" TextAlignment="Center"/>
                        <TextBlock Text="{Binding PostesCritiquesSansReleve}" FontSize="44"
                                   FontWeight="Bold" Foreground="#DC2626"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="risque de vacance" FontSize="11"
                                   Foreground="#9CA3AF" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Engagement moyen -->
                <Border Background="White" CornerRadius="16" Margin="8" Padding="24"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Engagement moyen" Foreground="#6B7280"
                                   FontSize="12" TextAlignment="Center"/>
                        <TextBlock FontSize="44" FontWeight="Bold" Foreground="#2563EB"
                                   HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Run Text="{Binding EngagementMoyen, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                        <TextBlock Text="score global" FontSize="11"
                                   Foreground="#9CA3AF" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- PIED DE PAGE -->
            <TextBlock Text="{Binding DateRapport}" FontSize="12" Foreground="#9CA3AF"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</UserControl>
