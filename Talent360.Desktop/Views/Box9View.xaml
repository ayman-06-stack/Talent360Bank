<UserControl x:Class="Talent360.Desktop.Views.Box9View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Talent360.Desktop.ViewModels"
             Height="Auto" Width="Auto">
    <Grid Margin="16">
        <TextBlock Text="9-Box" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
        <ItemsControl ItemsSource="{Binding Cells}" Margin="0,36,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" Margin="6" CornerRadius="6" Background="#0F172A">
                        <Button Background="Transparent" BorderThickness="0" Padding="12" Click="Cell_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Count}" Foreground="#60A5FA" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
