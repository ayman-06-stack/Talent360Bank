<Window x:Class="Talent360.Desktop.Views.CollaborateurListFilteredView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collaborateurs" Height="600" Width="800" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <DataGrid x:Name="Grid" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Matricule" Binding="{Binding Matricule}" />
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" />
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" />
                <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" />
                <DataGridTextColumn Header="Poste" Binding="{Binding Poste}" />
                <DataGridTextColumn Header="Performance" Binding="{Binding ScorePerformance}" />
                <DataGridTextColumn Header="Potentiel" Binding="{Binding ScorePotentiel}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
