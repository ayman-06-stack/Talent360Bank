<UserControl x:Class="Talent360.Desktop.Views.ComiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="Comité Talent" FontSize="28" FontWeight="Bold"
                       Foreground="#1B2A4A" Margin="0,0,0,8"/>
            <TextBlock Text="Collaborateurs proposés au comité — Performance ET Potentiel ≥ 80"
                       FontSize="13" Foreground="#6B7280" Margin="0,0,0,20"/>

            <!-- MESSAGE VIDE -->
            <Border Background="#FEF3C7" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding ADonnees, Converter={StaticResource InverseBoolToVisConverter}}">
                <TextBlock Text="{Binding MessageVide}" Foreground="#92400E" FontSize="14"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- CONTENU -->
            <StackPanel Visibility="{Binding ADonnees, Converter={StaticResource BoolToVisConverter}}">
                <Border Background="White" CornerRadius="12" Padding="16"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Membres}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="White"
                              RowBackground="White" AlternatingRowBackground="#F9FAFB"
                              SelectionMode="Single" SelectionUnit="FullRow" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nom" Binding="{Binding NomComplet}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="180"/>
                            <DataGridTextColumn Header="Poste" Binding="{Binding Poste}" Width="*"/>
                            <DataGridTextColumn Header="Perf." Binding="{Binding ScorePerformance, StringFormat=F1}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#059669"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pot." Binding="{Binding ScorePotentiel, StringFormat=F1}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#7C3AED"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
