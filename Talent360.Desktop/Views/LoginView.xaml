<UserControl x:Class="Talent360.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <!-- Login centre dans la fenetre -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="40,32"
                BorderBrush="#E5E7EB" BorderThickness="1"
                MinWidth="400" MaxWidth="440">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.08" ShadowDepth="4" Direction="270"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo / Titre -->
                <TextBlock Text="Talent360 Bank" FontSize="24" FontWeight="Bold"
                           Foreground="#1B2A4A" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Gestion des Talents" FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Champ identifiant -->
                <TextBlock Text="Identifiant" FontSize="13" Foreground="#374151" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" FontSize="14" Padding="10,8"
                         BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,16"/>

                <!-- Champ mot de passe -->
                <TextBlock Text="Mot de passe" FontSize="13" Foreground="#374151" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="10,8"
                             BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,0,8"/>

                <!-- Message d'erreur -->
                <TextBlock x:Name="LblErreur" FontSize="12" Foreground="#DC2626"
                           TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"/>

                <!-- Bouton de connexion -->
                <Button Content="Se connecter" Click="Login_Click"
                        Background="#1B2A4A" Foreground="White" FontSize="14" FontWeight="SemiBold"
                        Padding="0,12" Cursor="Hand" BorderThickness="0" Margin="0,8,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2D3F5E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
